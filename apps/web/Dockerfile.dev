FROM node:22-slim

ENV HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=development \
    PORT=3000

WORKDIR /app

COPY apps/web/package*.json ./

RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY apps/web/ ./

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
