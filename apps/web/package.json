{
  "name": "ai-trading-saas-starter-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "motion:rollout-audit": "node scripts/motion-rollout-audit.mjs",
    "motion:rollout-audit:json": "node scripts/motion-rollout-audit.mjs --json",
    "motion:rollout-audit:strict": "node scripts/motion-rollout-audit.mjs --json --strict",
    "motion:rollout-audit:report": "node scripts/motion-rollout-audit.mjs --json --strict --report --report-path=docs/motion-rollout-audit-report.md",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@next/env": "^15.3.1",
    "next": "^15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.1",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
